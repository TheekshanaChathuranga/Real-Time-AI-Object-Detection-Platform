# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yolo_platform
# For SQLite local fallback when PostgreSQL is not installed locally:
# DATABASE_URL=sqlite:///./yolo_platform.db

# File Storage Configuration
STORAGE_BACKEND=local
UPLOAD_DIRECTORY=./data/uploads
RESULT_DIRECTORY=./data/results
DATASET_DIRECTORY=./data/datasets
MODEL_DIRECTORY=./models/weights
MAX_UPLOAD_SIZE_MB=100

# ML & Inference Configuration
DEFAULT_MODEL=yolov8n.pt
DEVICE=auto
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
